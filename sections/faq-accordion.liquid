{%- comment -%}
  FAQ accordion
  - One "question" block per item, rendered as native <details>/<summary>.
  - Optional exclusive mode via the HTML `name` attribute (one item open at a time).
  - Optional FAQPage JSON-LD built from the same block settings.
  - No JavaScript. Open/close animation is CSS-only and disabled for
    prefers-reduced-motion (see assets/section-faq-accordion.css).
{%- endcomment -%}

{{ 'section-faq-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign group_name = 'faq-' | append: section.id
-%}

<div
  class="faq-accordion"
  style="--faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="faq-accordion__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-accordion__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="faq-accordion__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="faq-accordion__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}
          {%- continue -%}
        {%- endif -%}
        <details
          class="faq-accordion__item"
          {% if section.settings.single_open %}
            name="{{ group_name }}"
          {% endif %}
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="faq-accordion__question">
            <span class="faq-accordion__question-text">{{ block.settings.question | escape }}</span>
            <svg
              class="faq-accordion__icon"
              aria-hidden="true"
              focusable="false"
              width="16"
              height="16"
              viewBox="0 0 16 16"
            >
              <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="faq-accordion__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- liquid
  assign faq_count = 0
  if section.settings.enable_structured_data
    for block in section.blocks
      if block.settings.question != blank and block.settings.answer != blank
        assign faq_count = faq_count | plus: 1
      endif
    endfor
  endif
-%}

{%- if faq_count > 0 -%}
  {%- assign faq_separator = '' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {{ faq_separator }}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | json }}
              }
            }
            {%- assign faq_separator = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq_accordion.name",
  "tag": "section",
  "class": "section section--faq-accordion",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq_accordion.settings.heading.label",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.faq_accordion.settings.intro.label"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.faq_accordion.settings.open_first.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "t:sections.faq_accordion.settings.single_open.label",
      "info": "t:sections.faq_accordion.settings.single_open.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.faq_accordion.settings.header_seo.content"
    },
    {
      "type": "checkbox",
      "id": "enable_structured_data",
      "label": "t:sections.faq_accordion.settings.enable_structured_data.label",
      "info": "t:sections.faq_accordion.settings.enable_structured_data.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.faq_accordion.settings.header_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.faq_accordion.settings.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.faq_accordion.settings.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq_accordion.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq_accordion.blocks.question.settings.question.label",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq_accordion.blocks.question.settings.answer.label",
          "default": "<p>Describe how and when customers can return an order.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq_accordion.presets.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Describe how and when customers can return an order.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Explain your processing time and the delivery estimates for each region.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>List the countries you ship to and any duties or fees customers should expect.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
