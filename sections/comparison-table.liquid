{%- comment -%}
  Comparison table
  - Up to four columns (plans/products), configured on the section.
    Columns with an empty heading are not rendered.
  - One "row" block per feature (rows without a feature name are skipped). Each cell can show a check icon, a cross icon
    and/or text. Icons are decorative SVGs paired with visually hidden text.
  - Real <table> markup with <th scope="col"> and <th scope="row">.
  - On narrow screens the table scrolls horizontally inside a focusable,
    labelled region and the feature column stays pinned (position: sticky).
{%- endcomment -%}

{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_id = 'ComparisonTableHeading-' | append: section.id
  assign highlight = section.settings.highlight_column | plus: 0
  assign column_count = 0
  for i in (1..4)
    assign heading_key = 'column_' | append: i | append: '_heading'
    if section.settings[heading_key] != blank
      assign column_count = column_count | plus: 1
    endif
  endfor
-%}

<div
  class="comparison-table"
  style="--comparison-background: {{ section.settings.background_color }}; --comparison-text: {{ section.settings.text_color }}; --comparison-accent: {{ section.settings.accent_color }}; --comparison-padding-top: {{ section.settings.padding_top }}px; --comparison-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="comparison-table__inner">
    {%- if section.settings.heading != blank -%}
      <h2 id="{{ heading_id }}" class="comparison-table__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if column_count > 0 -%}
      <div
        class="comparison-table__scroll"
        role="region"
        tabindex="0"
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% else %}
          aria-label="{{ 'sections.comparison_table.region_label' | t | escape }}"
        {% endif %}
      >
        <table class="comparison-table__table">
          <thead>
            <tr>
              <th scope="col" class="comparison-table__corner">
                <span class="comparison-table__visually-hidden">{{ 'sections.comparison_table.feature' | t }}</span>
              </th>
              {%- for i in (1..4) -%}
                {%- assign heading_key = 'column_' | append: i | append: '_heading' -%}
                {%- if section.settings[heading_key] != blank -%}
                  <th
                    scope="col"
                    class="comparison-table__column-heading{% if highlight == i %} comparison-table__cell--highlight{% endif %}"
                  >
                    {%- if highlight == i and section.settings.highlight_label != blank -%}
                      <span class="comparison-table__badge">{{ section.settings.highlight_label | escape }}</span>
                    {%- endif -%}
                    {{ section.settings[heading_key] | escape }}
                  </th>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.settings.label == blank -%}
                {%- continue -%}
              {%- endif -%}
              <tr class="comparison-table__row" {{ block.shopify_attributes }}>
                <th scope="row" class="comparison-table__feature">
                  {{ block.settings.label | escape }}
                  {%- if block.settings.description != blank -%}
                    <span class="comparison-table__description">{{ block.settings.description | escape }}</span>
                  {%- endif -%}
                </th>
                {%- for i in (1..4) -%}
                  {%- assign heading_key = 'column_' | append: i | append: '_heading' -%}
                  {%- if section.settings[heading_key] != blank -%}
                    {%- assign icon_key = 'icon_' | append: i -%}
                    {%- assign text_key = 'text_' | append: i -%}
                    <td class="comparison-table__cell{% if highlight == i %} comparison-table__cell--highlight{% endif %}">
                      {%- render 'comparison-table-value',
                        icon: block.settings[icon_key],
                        text: block.settings[text_key]
                      -%}
                    </td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.comparison_table.name",
  "tag": "section",
  "class": "section section--comparison-table",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.comparison_table.settings.heading.label",
      "default": "Compare plans"
    },
    {
      "type": "header",
      "content": "t:sections.comparison_table.settings.header_columns.content",
      "info": "t:sections.comparison_table.settings.header_columns.info"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "t:sections.comparison_table.settings.column_1_heading.label",
      "default": "Basic"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "t:sections.comparison_table.settings.column_2_heading.label",
      "default": "Standard"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "t:sections.comparison_table.settings.column_3_heading.label",
      "default": "Premium"
    },
    {
      "type": "text",
      "id": "column_4_heading",
      "label": "t:sections.comparison_table.settings.column_4_heading.label"
    },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "t:sections.comparison_table.settings.highlight_column.label",
      "options": [
        { "value": "0", "label": "t:sections.comparison_table.settings.highlight_column.options__0.label" },
        { "value": "1", "label": "t:sections.comparison_table.settings.highlight_column.options__1.label" },
        { "value": "2", "label": "t:sections.comparison_table.settings.highlight_column.options__2.label" },
        { "value": "3", "label": "t:sections.comparison_table.settings.highlight_column.options__3.label" },
        { "value": "4", "label": "t:sections.comparison_table.settings.highlight_column.options__4.label" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "highlight_label",
      "label": "t:sections.comparison_table.settings.highlight_label.label",
      "default": "Most popular"
    },
    {
      "type": "header",
      "content": "t:sections.comparison_table.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.comparison_table.settings.background_color.label",
      "info": "t:sections.comparison_table.settings.background_color.info",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.comparison_table.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.comparison_table.settings.accent_color.label",
      "default": "#eef3ff"
    },
    {
      "type": "header",
      "content": "t:sections.comparison_table.settings.header_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.comparison_table.settings.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.comparison_table.settings.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.comparison_table.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.comparison_table.blocks.row.settings.label.label",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:sections.comparison_table.blocks.row.settings.description.label"
        },
        {
          "type": "header",
          "content": "t:sections.comparison_table.blocks.row.settings.header_column_1.content"
        },
        {
          "type": "select",
          "id": "icon_1",
          "label": "t:sections.comparison_table.blocks.row.settings.icon.label",
          "options": [
            { "value": "none", "label": "t:sections.comparison_table.blocks.row.settings.icon.options__none.label" },
            { "value": "check", "label": "t:sections.comparison_table.blocks.row.settings.icon.options__check.label" },
            { "value": "cross", "label": "t:sections.comparison_table.blocks.row.settings.icon.options__cross.label" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "t:sections.comparison_table.blocks.row.settings.text.label"
        },
        {
          "type": "header",
          "content": "t:sections.comparison_table.blocks.row.settings.header_column_2.content"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "t:sections.comparison_table.blocks.row.settings.icon.label",
